# Terraform state — never commit these
*.tfstate
*.tfstate.*
*.tfstate.backup

# Variable files with real values — user-generated from .example files
*.tfvars
!*.tfvars.example

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Crash log files
crash.log
crash.*.log

# Sensitive override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
